{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-8901-bcde-barterswapservices",
    "name": "BarterSwap — Gestion des services",
    "description": "Tous les cas de test de la partie annonces de services.\n\nPrérequis : API démarrée (`docker compose up --build`) sur http://localhost:8081\n\nExécuter dans l'ordre (Collection Runner) : les scripts créent un user + skills puis testent les services.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "userId", "value": "1" },
    { "key": "otherUserId", "value": "2" },
    { "key": "serviceId", "value": "1" },
    { "key": "suffix", "value": "" }
  ],
  "item": [
    {
      "name": "0. Setup utilisateurs",
      "item": [
        {
          "name": "POST créer provider — 201",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('suffix', Date.now().toString() + Math.floor(Math.random()*1000));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const u = pm.response.json();",
                  "pm.collectionVariables.set('userId', String(u.id));",
                  "console.log('userId=', u.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pseudo\": \"provider_{{suffix}}\",\n  \"ville\": \"Lyon\"\n}"
            },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "PUT skills provider — 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-ID", "value": "{{userId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skills\": [\n    { \"nom\": \"Jardinage\", \"niveau\": \"expert\" },\n    { \"nom\": \"Cuisine\", \"niveau\": \"débutant\" },\n    { \"nom\": \"Sport\", \"niveau\": \"intermédiaire\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}/skills"
          }
        },
        {
          "name": "POST créer other — 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('otherUserId', String(pm.response.json().id));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pseudo\": \"other_{{suffix}}\",\n  \"ville\": \"Paris\"\n}"
            },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "PUT skills other — 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-ID", "value": "{{otherUserId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skills\": [\n    { \"nom\": \"Jardinage\", \"niveau\": \"débutant\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/users/{{otherUserId}}/skills"
          }
        }
      ]
    },
